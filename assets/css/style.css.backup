/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    line-height: 1.6;
    background-color: #fff;
    color: #333;
}

/* Header */
header {
    background-color: #fff;
    padding: 20px 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
}

header .logo {
    display: flex;
    align-items: center;
    gap: 10px;
}

header .logo img {
    height: 50px;
    width: auto;
    display: block; /* hilangkan sela putih */
}

header .logo h1 {
    font-size: 24px;
    font-weight: 600;
    color: #4b2e2e;
}

/* Navigation */
nav ul {
    list-style: none;
    display: flex;
    gap: 30px;
}

nav ul li a {
    text-decoration: none;
    font-weight: 500;
    color: #4b2e2e;
    transition: color 0.3s ease;
}

nav ul li a:hover {
    color: #000;
}

/* Zoom Overlay - Enhanced */
.zoom-overlay {
    position: fixed;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0s 0.2s;
    padding: 20px;
    box-sizing: border-box;
    overflow: hidden;
}

.zoom-overlay.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
}

.zoom-image-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
}

.zoom-image-container img {
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
    border-radius: 4px;
    box-shadow: 0 5px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease;
    transform: scale(0.95);
}

.zoom-overlay.active .zoom-image-container img {
    transform: scale(1);
}

.zoom-close {
    position: fixed;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10001;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
}

.zoom-close:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: rotate(90deg);
}

.zoom-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10001;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0.8;
}

.zoom-nav:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%) scale(1.1);
    opacity: 1;
}

.zoom-prev {
    left: 20px;
}

.zoom-next {
    right: 20px;
}

.zoom-counter {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: white;
    font-size: 14px;
    font-weight: 500;
    background: rgba(0, 0, 0, 0.5);
    padding: 6px 16px;
    border-radius: 20px;
    z-index: 10001;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
}

/* Disable body scroll when zoomed */
body.zoom-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
    height: 100%;
}

/* Hero Section */
.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 60px 50px;
    gap: 40px;
}

.hero-text {
    max-width: 50%;
}

.hero-text h2 {
    font-size: 40px;
    font-weight: 700;
    color: #4b2e2e;
    margin-bottom: 20px;
}

.hero-text p {
    font-size: 18px;
    margin-bottom: 20px;
    color: #555;
}

.hero-text .btn {
    background-color: #4b2e2e;
    color: #fff;
    text-decoration: none;
    padding: 12px 25px;
    border-radius: 8px;
    font-weight: 500;
    transition: background-color 0.3s ease;
}

.hero-text .btn:hover {
    background-color: #333;
}

.furniture-frame,
.process-frame {
    position: relative;
    width: 50%;
    overflow: hidden;
    border-radius: 0 200px 0 0; /* furniture */
    border: 1px solid #ccc;     /* untuk process */
    line-height: 0; /* trik penting, hilangkan sela bawaan teks */
}

.furniture-frame img,
.process-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}


/* Process Section */
.process {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 60px 50px;
    gap: 40px;
    border-top: 1px solid #eee;
}

.process-text {
    max-width: 50%;
}

.process-text h2 {
    font-size: 32px;
    font-weight: 700;
    color: #4b2e2e;
    margin-bottom: 20px;
}

.process-text p {
    font-size: 16px;
    margin-bottom: 15px;
    color: #555;
}

.process-frame {
    position: relative;
    width: 50%;
    overflow: hidden;
    border: 1px solid #ccc;
    border-radius: 0 0 200px 0;
}

.process-frame img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block; /* cegah sela putih */
}

/* Footer */
footer {
    background-color: #f8f8f8;
    text-align: center;
    padding: 20px;
    font-size: 14px;
    color: #666;
    border-top: 1px solid #ddd;
}
